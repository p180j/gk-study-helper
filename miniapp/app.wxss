page { background: #f2f7ff; color: #102443; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { min-height: 100vh; box-sizing: border-box; padding: 24rpx; }
.hero { margin: 8rpx 4rpx 24rpx; }
.hero-title { font-size: 44rpx; font-weight: 750; line-height: 1.25; letter-spacing: -1rpx; }
.hero-subtitle { color: #7b8ba5; font-size: 25rpx; margin-top: 8rpx; }
.card { background: rgba(255,255,255,.96); border: 1rpx solid rgba(215,228,247,.8); border-radius: 26rpx; padding: 26rpx; margin-bottom: 20rpx; box-shadow: 0 12rpx 34rpx rgba(42, 91, 160, .08); }
.section-title { font-size: 31rpx; font-weight: 700; margin-bottom: 18rpx; }
.muted { color: #7b8ba5; font-size: 24rpx; }
.tag { display: inline-block; color: #087d78; background: #e5fbf7; border-radius: 999rpx; padding: 6rpx 16rpx; font-size: 22rpx; margin-right: 10rpx; }
.primary { background: linear-gradient(100deg, #1677ff, #13cbb1) !important; color: #fff !important; border: 0 !important; border-radius: 999rpx; font-size: 29rpx; font-weight: 650; box-shadow: 0 10rpx 24rpx rgba(22,119,255,.18); }
.secondary { background: #edf5ff !important; color: #1677ff !important; border: 0 !important; border-radius: 999rpx; font-size: 27rpx; }
.state { text-align: center; color: #68716c; padding: 100rpx 24rpx; }
.error { color: #e45365; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; }
.divider { height: 1rpx; background: #edf2f9; margin: 20rpx 0; }
.progress-track { height: 15rpx; border-radius: 999rpx; background: #dfe8f5; overflow: hidden; }
.progress-fill { height: 100%; border-radius: inherit; background: linear-gradient(90deg,#1677ff,#19c9ba); }
.status-unassessed { color: #8b99ad; background: #eef2f7; }
