page { background: #f3f5f1; color: #24332d; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; }
.page { padding: 28rpx; }
.hero { margin: 12rpx 0 28rpx; }
.hero-title { font-size: 48rpx; font-weight: 700; line-height: 1.25; }
.hero-subtitle { color: #69736d; font-size: 26rpx; margin-top: 10rpx; }
.card { background: #fff; border-radius: 22rpx; padding: 28rpx; margin-bottom: 22rpx; box-shadow: 0 8rpx 26rpx rgba(42, 64, 54, .06); }
.section-title { font-size: 32rpx; font-weight: 650; margin-bottom: 20rpx; }
.muted { color: #7a817d; font-size: 25rpx; }
.tag { display: inline-block; color: #1f6f55; background: #e8f4ee; border-radius: 999rpx; padding: 6rpx 16rpx; font-size: 22rpx; margin-right: 10rpx; }
.primary { background: #1f6f55 !important; color: #fff !important; border-radius: 16rpx; font-size: 28rpx; }
.secondary { background: #e8f0eb !important; color: #1f6f55 !important; border-radius: 16rpx; font-size: 28rpx; }
.state { text-align: center; color: #68716c; padding: 100rpx 24rpx; }
.error { color: #b4443f; }
.row { display: flex; justify-content: space-between; align-items: center; gap: 18rpx; }
.divider { height: 1rpx; background: #edf0ed; margin: 20rpx 0; }
