<view class="page">
  <view class="hero"><view class="hero-title">我的能力画像</view><view class="hero-subtitle">先看整体，再查看各模块</view></view>
  <view wx:if="{{loading}}" class="state">正在读取真实能力数据…</view>
  <view wx:elif="{{error}}" class="state error"><view>{{error}}</view><button class="secondary" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="card overview-card">
      <view class="row"><view><view class="section-title">行测综合能力</view><view class="muted">正式能力分需五个模块各完成 20 题<text wx:if="{{abilityView.xingceAssessingCount}}"> · {{abilityView.xingceAssessingCount}} 项摸底中</text></view></view><view class="overall-score {{abilityView.xingce.evaluated ? '' : 'unassessed'}}">{{abilityView.xingce.evaluated ? abilityView.xingce.score : (abilityView.xingce.assessing ? '建立中' : '未测评')}}</view></view>
      <view wx:if="{{abilityView.xingce.evaluated}}" class="overall-copy">当前已测水平，继续完成未测模块后形成更完整的行测判断。</view>
      <view wx:else class="overall-copy">能力画像建立中。完成今日摸底后，系统会用真实作答形成你的行测能力图。</view>
      <view class="coverage-line"><view class="progress-track"><view class="progress-fill" style="width: {{overview.coveragePercent}}%"></view></view><text>核心能力已评估 {{overview.evaluatedCount}} / {{overview.totalCount}}<text wx:if="{{overview.assessingCount}}"> · {{overview.assessingCount}} 项摸底中</text></text></view>
    </view>

    <view class="card radar-card">
      <view class="row"><view class="section-title">六维能力图</view><text class="radar-progress">已评估 {{abilityView.evaluatedCount}} / 6</text></view>
      <view class="muted radar-copy">六个方向始终完整显示；“待测评”表示数据不足，不代表低分。</view>
      <canvas canvas-id="ability-radar" class="radar-canvas" width="{{radarCanvasWidth}}" height="{{radarCanvasHeight}}"></canvas>
      <view class="axis-grid">
        <view wx:for="{{radarAxes}}" wx:key="code" class="axis-item {{item.evaluated ? 'evaluated' : 'unassessed'}} {{selectedAxisCode === item.code ? 'selected' : ''}}" data-code="{{item.code}}" bindtap="selectAxis"><view class="axis-name">{{item.name}}</view><view class="axis-score">{{item.scoreText}}</view></view>
      </view>
    </view>

    <view wx:if="{{selectedAxis}}" class="card module-detail">
      <view class="row"><view><view class="section-title">{{selectedAxis.name}}</view><view class="muted">{{selectedAxis.sampleText}}</view></view><text class="detail-score {{selectedAxis.evaluated ? '' : 'unassessed'}}">{{selectedAxis.scoreText}}</text></view>
      <view wx:if="{{selectedAxis.evaluated && selectedAxis.trendText}}" class="trend-copy">{{selectedAxis.trendText}}</view>
      <view wx:else class="trend-copy">{{selectedAxis.evaluated ? '继续练习，系统会持续更新趋势。' : (selectedAxis.assessing ? '当前仍在摸底中，满 20 题后才展示能力分。' : '未测评不会被算作低分，完成相关题目后再形成判断。')}}</view>
      <button class="secondary train-button" data-code="{{selectedAxis.code}}" bindtap="startTraining">{{selectedAxis.code === 'SHENLUN' ? '去申论训练' : '去针对训练'}} 〉</button>
    </view>
  </block>
</view>
