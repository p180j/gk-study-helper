.coach-button { margin:0; border:0; border-radius:999rpx; color:#087d78; background:#e5fbf7; font-size:22rpx; }.coach-button::after { border:0; }
.overview-card { border-top:6rpx solid #1677ff; }.overall-score { min-width:110rpx; color:#1677ff; font-size:62rpx; font-weight:850; text-align:right; }.overall-score.unassessed { color:#71819a; font-size:29rpx; }.overall-copy { margin-top:18rpx; color:#536887; font-size:24rpx; line-height:1.6; }.coverage-line { display:flex; align-items:center; gap:16rpx; margin-top:22rpx; color:#7b8ba5; font-size:20rpx; }.coverage-line .progress-track { flex:1; }
.radar-card { padding:28rpx 22rpx; }.radar-copy { margin-top:10rpx; line-height:1.5; }.radar-progress { padding:5rpx 12rpx; border-radius:999rpx; color:#087d78; background:#e5fbf7; font-size:20rpx; }.radar-canvas { display:block; width:640rpx; height:564rpx; margin:10rpx auto 2rpx; }.axis-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:12rpx; }.axis-item { padding:17rpx; border-radius:17rpx; background:#f5f8fd; border:2rpx solid transparent; }.axis-item.evaluated { background:#f0f8ff; }.axis-item.unassessed { background:#f5f6f8; color:#8b99ad; }.axis-item.selected { border-color:#1677ff; box-shadow:0 5rpx 15rpx rgba(22,119,255,.1); }.axis-name { font-size:23rpx; font-weight:700; }.axis-score { margin-top:6rpx; color:#1677ff; font-size:28rpx; font-weight:800; }.axis-item.unassessed .axis-score { color:#8b99ad; font-size:22rpx; font-weight:500; }
.module-detail { border-left:6rpx solid #18b99e; }.detail-score { color:#1677ff; font-size:35rpx; font-weight:800; }.detail-score.unassessed { color:#8b99ad; font-size:25rpx; font-weight:500; }.trend-copy { margin-top:20rpx; color:#536887; font-size:24rpx; line-height:1.6; }.train-button { display:block; margin:22rpx 0 0 auto; border:0; border-radius:999rpx; color:#fff; background:linear-gradient(90deg,#1677ff,#16c8b3); font-size:21rpx; }
.problem-heading { margin:32rpx 6rpx 14rpx; }.empty-problem { display:flex; align-items:center; gap:18rpx; }.empty-icon { width:60rpx; height:60rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:#18b99e; }.empty-title,.problem-title { font-weight:700; }.problem-card { border-left:6rpx solid #ef5c6f; }.root-cause { margin-top:18rpx; padding:16rpx; border-radius:16rpx; color:#365b6b; background:#f0faf9; line-height:1.6; }.evidence { margin:14rpx 0; line-height:1.55; }
