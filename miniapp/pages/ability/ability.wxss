.ability-name { font-size: 31rpx; font-weight: 650; }
.metrics { display: grid; grid-template-columns: repeat(4, 1fr); gap: 10rpx; margin: 26rpx 0 18rpx; text-align: center; }
.metrics text { display: block; font-size: 34rpx; font-weight: 700; color: #1f6f55; }
.metrics label { display: block; color: #7a817d; font-size: 22rpx; margin-top: 4rpx; }
.problems-title { margin-top: 38rpx; }
.evidence { margin-top: 16rpx; line-height: 1.6; color: #56615b; font-size: 25rpx; }
