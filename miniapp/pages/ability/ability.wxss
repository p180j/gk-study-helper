.coach-button { margin:0; border:0; border-radius:999rpx; color:#087d78; background:#e5fbf7; font-size:22rpx; }.coach-button::after { border:0; }
.coverage-grid { display:grid; grid-template-columns:1.35fr .85fr; gap:14rpx; }.coverage-card,.trend-card { margin-bottom:20rpx; }.coverage-line { margin:8rpx 0 14rpx; color:#8493a8; font-size:26rpx; }.coverage-line text { color:#1677ff; font-size:44rpx; font-weight:800; }.coverage-card .muted { margin-top:14rpx; }.trend-card { text-align:center; background:linear-gradient(145deg,#fff,#eff8ff); }.trend-icon { margin:8rpx auto 14rpx; color:#17bda8; font-size:70rpx; font-weight:800; }.trend-title { margin-bottom:10rpx; font-weight:700; }
.section-tabs { display:flex; margin:6rpx 0 24rpx; padding:6rpx; border-radius:18rpx; background:#e8f0fb; }.section-tab { flex:1; text-align:center; padding:13rpx 8rpx; border-radius:14rpx; color:#6f8099; font-size:24rpx; }.section-tab.selected { color:#1677ff; background:#fff; box-shadow:0 5rpx 16rpx rgba(42,91,160,.09); font-weight:700; }.ability-heading,.problem-heading { margin:28rpx 6rpx 14rpx; }.ability-list { padding:8rpx 24rpx; }.ability-row { display:flex; gap:18rpx; padding:22rpx 0; border-bottom:1rpx solid #edf2f9; }.ability-row:last-child { border-bottom:0; }.ability-icon { width:56rpx; height:56rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:17rpx; color:#fff; background:#2382ff; font-size:21rpx; font-weight:750; }.ability-icon.SHENLUN { background:#18b99e; }.ability-main { flex:1; min-width:0; }.ability-name { font-weight:700; }.score-wrap { display:flex; align-items:center; gap:12rpx; }.score { color:#15335d; font-size:26rpx; font-weight:750; }.score.unassessed { color:#8b99ad; font-size:22rpx; font-weight:500; }.score.weak { color:#d97b2f; }.score.improving { color:#1fa377; }.trend { font-size:22rpx; font-weight:750; }.trend.up { color:#1fa377; }.trend.down { color:#e45365; }.ability-row.weak { box-shadow: inset 6rpx 0 0 rgba(230,126,34,.35); }.ability-track { height:13rpx; margin:12rpx 0 9rpx; overflow:hidden; border-radius:999rpx; background:#dfe7f2; }.ability-fill { height:100%; border-radius:inherit; background:linear-gradient(90deg,#1677ff,#20b7dc); }.ability-fill.weak { background:linear-gradient(90deg,#f0a35e,#e08a4c); }.ability-meta { display:flex; justify-content:space-between; align-items:center; gap:12rpx; }.ability-meta .metric-copy { color:#7b8ba5; }.weak-tag { flex:none; color:#c26a1b; background:rgba(230,126,34,.13); border-radius:999rpx; padding:4rpx 14rpx; font-size:19rpx; font-weight:650; }.metric-copy { font-size:20rpx; }
.empty-problem { display:flex; align-items:center; gap:18rpx; }.empty-icon { width:60rpx; height:60rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:#18b99e; }.empty-title { font-weight:700; margin-bottom:6rpx; }.problem-card { border-left:6rpx solid #ef5c6f; }.problem-title { font-weight:700; }.root-cause { margin-top:18rpx; padding:16rpx; border-radius:16rpx; color:#365b6b; background:#f0faf9; line-height:1.6; }.evidence { margin:14rpx 0; line-height:1.55; }.train-button { margin:4rpx 0 0 auto; border:0; border-radius:999rpx; color:#fff; background:linear-gradient(90deg,#1677ff,#16c8b3); font-size:21rpx; }
