<view class="page">
  <view class="coach-hero"><view class="coach-orb">AI</view><view><view class="hero-title">AI 学习教练</view><view class="hero-subtitle">基于真实数据，解释能力、问题和今日计划</view></view></view>
  <view wx:if="{{loading}}" class="state">正在整理你的学习状态…</view>
  <block wx:else>
    <view wx:if="{{summary}}" class="card summary-card">
      <view class="summary-eyebrow">当前最需要提升</view>
      <view class="conclusion">{{summary.problem}}</view>
      <view wx:if="{{summary.evidence.length}}" class="summary-section">
        <view class="mini-title">关键证据</view>
        <view wx:for="{{summary.evidence}}" wx:key="*this" class="line">· {{item}}</view>
      </view>
      <view class="next-step"><text class="next-arrow">→</text><text class="next-text">{{summary.suggestion}}</text></view>
    </view>
    <view wx:if="{{result}}" class="card detail-card">
      <view class="detail-toggle" bindtap="toggleDetail">{{detailExpanded ? '收起详细分析 ▴' : '查看详细分析 ▾'}}</view>
      <block wx:if="{{detailExpanded}}">
        <view class="detail-section"><view class="section-title">我现在怎么样</view><view class="coach-copy">{{result.currentStatus}}</view></view>
        <view class="detail-section"><view class="section-title">真正的问题</view><view wx:for="{{result.coreProblems}}" wx:key="*this" class="line">· {{item}}</view></view>
        <view class="detail-section"><view class="section-title">今天为什么这样学</view><view class="coach-copy">{{result.todayReason}}</view></view>
        <view class="detail-section"><view class="section-title">教练完整回答</view><view class="coach-copy">{{result.answer}}</view></view>
        <view class="detail-section"><view class="section-title">真实数据依据</view><view wx:for="{{result.evidence}}" wx:key="*this" class="line muted">· {{item}}</view></view>
      </block>
    </view>
    <view wx:elif="{{asking}}" class="card generating-card">AI 教练正在基于你的真实学习数据生成分析…</view>
    <view wx:elif="{{error}}" class="card error"><view>AI 教练暂时不可用。你仍可以查看上方基于真实数据的建议。</view><button class="secondary retry-button" size="mini" bindtap="ask">重试 AI 分析</button></view>
  </block>
  <view class="card">
    <textarea class="question" value="{{question}}" bindinput="onInput" placeholder="继续追问，例如：我最该先改什么？"></textarea>
    <button class="primary" loading="{{asking}}" disabled="{{asking}}" bindtap="ask">{{result ? '重新生成 AI 分析' : '生成 AI 分析'}} </button>
  </view>
</view>
