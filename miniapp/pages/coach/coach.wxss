.coach-hero { display:flex; gap:20rpx; align-items:center; margin:10rpx 4rpx 28rpx; padding:28rpx; border-radius:28rpx; background:linear-gradient(135deg,#dcefff,#e5fff9); }.coach-orb { width:84rpx; height:84rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:26rpx; color:#fff; font-size:28rpx; font-weight:800; background:linear-gradient(135deg,#1677ff,#16c8b3); box-shadow:0 10rpx 25rpx rgba(22,119,255,.2); }
.summary-card { border-top:6rpx solid #18b99e; }
.summary-eyebrow { color:#087d78; font-size:23rpx; font-weight:700; margin-bottom:10rpx; }
.conclusion { font-size:34rpx; font-weight:800; color:#15335d; line-height:1.5; }
.summary-section { margin-top:22rpx; padding-top:22rpx; border-top:1rpx solid #edf2f9; }
.mini-title { color:#7b8ba5; font-size:22rpx; margin-bottom:4rpx; }
.line { margin:12rpx 0; line-height:1.6; }
.next-step { margin-top:22rpx; padding:18rpx 20rpx; border-radius:16rpx; background:#e5fbf7; display:flex; gap:12rpx; align-items:center; }
.next-arrow { flex:none; color:#0a8f80; font-size:28rpx; font-weight:800; }
.next-text { color:#087d78; font-size:26rpx; font-weight:700; line-height:1.5; }
.detail-toggle { text-align:center; color:#1677ff; font-size:26rpx; font-weight:650; padding:4rpx 0 18rpx; }
.detail-section { border-top:1rpx solid #edf2f9; margin-top:20rpx; padding-top:20rpx; }
.detail-section .section-title { margin-bottom:12rpx; }
.coach-copy { line-height:1.7; }
.generating-card { text-align:center; color:#7b8ba5; }
.retry-button { margin-top:16rpx; }
.question { width:100%; min-height:150rpx; box-sizing:border-box; background:#f2f7fd; border:1rpx solid #dce8f7; border-radius:20rpx; padding:20rpx; margin-bottom:18rpx; }
