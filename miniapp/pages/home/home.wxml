<view class="page">
  <view class="welcome">
    <view><view class="hero-title">早上好 👋</view><view class="hero-subtitle">坚持每天进步一点点</view></view>
    <view class="brand-mark">AI</view>
  </view>
  <view wx:if="{{loading}}" class="state">正在读取今日计划…</view>
  <view wx:elif="{{error}}" class="state error"><view>{{error}}</view><button class="secondary" bindtap="load">重新加载</button></view>
  <block wx:else>
    <view class="card today-card">
      <view class="row"><view class="section-title">今天学什么</view><view class="plan-count">{{completedCount}} / {{plan.items.length}}</view></view>
      <view class="progress-track"><view class="progress-fill" style="width: {{progressPercent}}%"></view></view>
      <view wx:if="{{currentItem}}" class="current-task">
        <view class="current-task-name">{{currentItem.knowledgePointName}}</view>
        <view class="muted">{{currentItem.reason}}</view>
        <view class="task-meta"><text class="purpose purpose-{{currentItem.purpose}}">{{currentItem.purposeLabel}}</text><text>{{currentItem.plannedMinutes}} 分钟</text><text wx:if="{{currentItem.targetQuestionCount}}">已完成 {{currentItem.completedQuestionCount || 0}} / {{currentItem.targetQuestionCount}} 题</text></view>
        <button class="primary" bindtap="startFirst">{{currentItem.status === 'COMPLETED' ? '查看今日学习' : '继续今日学习'}} 〉</button>
      </view>
      <view wx:else class="muted plan-copy">今日计划已完成，去学习页主动练习，继续巩固吧。</view>
      <view class="today-link" bindtap="viewTodayTasks">{{remainingCount ? '查看并切换今日任务' : '查看今日完成情况'}} 〉</view>
    </view>
    <view class="card insight-card">
      <view class="row"><view class="section-title ai-title">AI 今日洞察 ✦</view><button class="link-button" size="mini" bindtap="openCoach">问 AI 教练 〉</button></view>
      <view wx:if="{{insight && insight.source !== 'BASELINE'}}" class="insight-content"><view class="insight-icon">◎</view><view class="insight-copy"><view class="eyebrow">今天最值得解决</view><view class="insight-name">{{insight.problem}}</view><view class="insight-suggestion">建议：{{insight.suggestion}}</view></view></view>
      <view wx:else class="insight-content"><view class="insight-icon new">?</view><view><view class="eyebrow">先建立能力基线</view><view class="insight-name">完成今日摸底</view><view class="muted">样本不足时不判断强弱，先用真实作答认识你。</view></view></view>
    </view>
    <view class="section-title focus-heading">今天重点解决</view>
    <view wx:if="{{coreProblem}}" class="card focus-card">
      <view class="row"><view class="focus-title">{{coreProblem.knowledgePointName}} · {{coreProblem.problemTypeText}}</view><text class="tag">{{coreProblem.statusText}}</text></view>
      <view wx:if="{{coreProblem.rootCauseText}}" class="root-cause">主要原因：{{coreProblem.rootCauseText}}</view>
      <view class="muted evidence">{{coreProblem.evidenceText}}</view>
      <button class="focus-action" bindtap="startProblemTraining">开始针对训练 〉</button>
    </view>
    <view wx:else class="card focus-empty"><view class="focus-empty-icon">✓</view><view><view class="focus-title">暂未确认学习问题</view><view class="muted">先完成真实练习，系统再判断当前最值得解决的问题。</view></view></view>
  </block>
</view>
