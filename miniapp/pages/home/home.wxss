.welcome { margin: 8rpx 4rpx 24rpx; padding: 26rpx 20rpx; border-radius: 28rpx; display:flex; align-items:center; justify-content:space-between; background:linear-gradient(135deg,#dff2ff,#e3fffa); }
.brand-mark { width:72rpx; height:72rpx; line-height:72rpx; text-align:center; border-radius:24rpx; color:#fff; font-weight:800; background:linear-gradient(135deg,#1677ff,#16c8b3); box-shadow:0 10rpx 24rpx rgba(22,119,255,.2); }
.today-card { padding:30rpx; }.today-card .primary { margin-top:24rpx; }.plan-count { color:#1266c8; font-weight:700; }.plan-copy { margin-top:18rpx; line-height:1.55; }.current-task { padding-top:22rpx; }.current-task-name { margin-bottom:10rpx; color:#15335d; font-size:36rpx; font-weight:800; }.task-meta { display:flex; gap:12rpx; flex-wrap:wrap; align-items:center; margin-top:14rpx; color:#71819a; font-size:21rpx; }.today-link { margin-top:22rpx; color:#1677ff; font-size:24rpx; font-weight:650; text-align:center; }.inline-link { text-align:left; margin-top:14rpx; }
.ai-title { color:#1266c8; }.link-button { margin:0; padding:0; border:0; color:#1677ff; background:transparent; font-size:23rpx; }.link-button::after { border:0; }
.insight-card { border-top:5rpx solid #18c5b2; }.insight-content { display:flex; gap:22rpx; align-items:center; }.insight-icon { width:76rpx; height:76rpx; border-radius:24rpx; flex:none; display:flex; align-items:center; justify-content:center; font-size:42rpx; color:#ef4965; background:#fff0f2; }.insight-icon.new { color:#1677ff; background:#eaf3ff; }
.eyebrow { color:#7b8ba5; font-size:22rpx; }.insight-copy { flex:1; min-width:0; }.insight-name { margin:5rpx 0; font-size:29rpx; font-weight:750; line-height:1.45; display:-webkit-box; -webkit-box-orient:vertical; -webkit-line-clamp:2; overflow:hidden; }.insight-suggestion { color:#087d78; font-size:24rpx; line-height:1.5; }.reason-box { margin:-4rpx 0 18rpx; padding:18rpx; border-radius:18rpx; color:#536887; font-size:23rpx; line-height:1.55; background:#f3f8ff; }
.purpose { display:inline-block; padding:5rpx 13rpx; border-radius:999rpx; color:#1677ff; background:#eaf3ff; font-size:19rpx; }.purpose-ASSESSMENT { color:#9d6a00; background:#fff4d9; }.purpose-VALIDATION { color:#e14e65; background:#fff0f2; }.purpose-MAINTENANCE { color:#087d78; background:#e5fbf7; }
.coverage-number { margin-bottom:14rpx; color:#1677ff; font-size:42rpx; font-weight:800; }.coverage-number text { color:#8a9ab0; font-size:25rpx; font-weight:500; }.coverage-copy { margin-top:14rpx; }
