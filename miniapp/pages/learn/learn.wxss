.section-row { display:flex; justify-content:space-between; align-items:center; margin:28rpx 6rpx 12rpx; }.continue-card { padding:30rpx; }.switch-copy { color:#1677ff; font-size:23rpx; }.continue-main { display:flex; justify-content:space-between; gap:20rpx; padding:8rpx 0 22rpx; }.continue-title { font-size:34rpx; font-weight:750; margin-bottom:8rpx; }.progress-copy { margin-top:12rpx; }.task-illustration { width:110rpx; height:110rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:28rpx; color:#1677ff; font-size:54rpx; background:linear-gradient(145deg,#eaf3ff,#d9e9ff); }
.independent-practice { margin-top:20rpx; padding:26rpx; border:2rpx solid #d9eee9; }.independent-copy { margin-top:8rpx; line-height:1.45; }.independent-mark { padding:7rpx 13rpx; border-radius:999rpx; color:#087d78; background:#e5fbf7; font-size:20rpx; }.module-shortcuts { display:grid; grid-template-columns:repeat(2,1fr); gap:12rpx; margin-top:22rpx; }.module-shortcut { padding:18rpx; border-radius:17rpx; background:#f1f8ff; border:1rpx solid #d9eaff; }.module-shortcut:active { background:#e5f3ff; }.module-shortcut-name { color:#15335d; font-size:25rpx; font-weight:750; }.module-shortcut-stock { margin-top:8rpx; color:#1677ff; font-size:20rpx; }.independent-empty { margin-top:20rpx; }.independent-links { display:flex; flex-wrap:wrap; gap:12rpx 20rpx; margin-top:22rpx; padding-top:18rpx; border-top:1rpx solid #e7f0ee; color:#287273; font-size:21rpx; }.independent-links text { text-decoration:underline; }
.task-picker { padding:26rpx; border:2rpx solid #cfe2ff; }.picker-close { color:#1677ff; font-size:23rpx; }.picker-hint { margin:-4rpx 0 14rpx; line-height:1.5; }.task-choice { display:flex; align-items:center; gap:16rpx; padding:20rpx 0; border-top:1rpx solid #edf2f9; }.task-choice.selected { margin:0 -10rpx; padding:20rpx 10rpx; border-radius:18rpx; background:#f0f7ff; }.task-choice-main { flex:1; min-width:0; }.task-choice-name { margin-bottom:7rpx; color:#15335d; font-weight:750; }.task-choice-meta { display:flex; gap:10rpx; align-items:center; flex-wrap:wrap; margin-top:11rpx; color:#71819a; font-size:20rpx; }.task-choice-arrow { color:#1677ff; font-size:28rpx; }.problem-recommend { display:flex; align-items:center; gap:16rpx; padding:22rpx; }.problem-icon { width:64rpx; height:64rpx; flex:none; display:flex; align-items:center; justify-content:center; border-radius:20rpx; color:#087d78; background:#e5fbf7; font-size:34rpx; }
.recommend { display:flex; align-items:center; gap:18rpx; padding:22rpx; }.recommend-icon { width:70rpx; height:70rpx; flex:none; border-radius:20rpx; display:flex; align-items:center; justify-content:center; color:#1677ff; background:#eaf3ff; font-weight:750; }.recommend-icon.ESSAY { color:#5e55dc; background:#efedff; }.recommend-icon.READING { color:#078a75; background:#e5fbf7; }.recommend-body { flex:1; min-width:0; }.recommend-title { font-weight:700; }.recommend-reason { margin-top:7rpx; line-height:1.45; }.purpose { font-size:18rpx; padding:4rpx 10rpx; border-radius:999rpx; color:#1677ff; background:#eaf3ff; }.purpose-ASSESSMENT { color:#a56c00; background:#fff3d4; }.purpose-VALIDATION { color:#e14e65; background:#fff0f2; }.purpose-MAINTENANCE { color:#087d78; background:#e5fbf7; }.mini-action { margin:0; border:0; border-radius:999rpx; color:#fff; background:linear-gradient(100deg,#1677ff,#14c7b3); font-size:20rpx; }
.free-title { margin:30rpx 6rpx 14rpx; }.free-grid { display:grid; grid-template-columns:1fr 1fr; gap:14rpx; }.free-entry { display:flex; gap:16rpx; align-items:center; padding:23rpx; border-radius:22rpx; background:#fff; box-shadow:0 8rpx 24rpx rgba(42,91,160,.07); font-weight:700; }.free-entry text { display:block; margin-top:5rpx; color:#8290a5; font-size:20rpx; font-weight:400; }.free-icon { width:58rpx; height:58rpx; display:flex; align-items:center; justify-content:center; border-radius:18rpx; color:#fff; }.blue .free-icon { background:#2382ff; }.indigo .free-icon { background:#685ee8; }.green .free-icon { background:#18b99e; }.orange .free-icon { background:#ff953f; }
.teal .free-icon { background:linear-gradient(145deg,#1677ff,#18b99e); }.practice-head { margin-bottom:18rpx; }.back-button { margin:0; border:0; color:#1677ff; background:#fff; border-radius:999rpx; }.question-card { padding:30rpx; }.question-kp { font-weight:700; }.stem { font-size:32rpx; line-height:1.7; margin:30rpx 0; }.option { display:flex; gap:18rpx; padding:22rpx; border:2rpx solid #e1e9f5; border-radius:18rpx; margin-bottom:15rpx; background:#fff; }.option.selected,.choice.selected { border-color:#1677ff; background:#edf5ff; color:#0f61c9; }.option-key { font-weight:750; min-width:38rpx; }.label { margin:28rpx 0 14rpx; font-weight:650; }.choices { display:flex; gap:12rpx; }.choice { flex:1; text-align:center; padding:16rpx 8rpx; border:2rpx solid #e1e9f5; border-radius:16rpx; }.picker { padding:20rpx; background:#f3f7fc; border-radius:16rpx; margin-bottom:28rpx; }
.result { text-align:left; border-top:6rpx solid #16b99d; }.result.wrong { border-top-color:#ef5c6f; }.result-badge { width:70rpx; height:70rpx; margin:0 auto 12rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:#16b99d; font-size:40rpx; font-weight:800; }.wrong .result-badge { background:#ef5c6f; }.result-title { text-align:center; font-size:36rpx; font-weight:750; margin-bottom:20rpx; }.answer-line { font-weight:650; }.analysis { line-height:1.7; margin:20rpx 0; color:#536887; }.diagnosis { margin:24rpx 0; padding:22rpx; border-radius:20rpx; background:#f2fbfa; border:1rpx solid #d5f4ef; }.ai-label { color:#087d78; font-weight:700; margin-bottom:14rpx; }.diagnosis-actions { display:flex; gap:16rpx; margin-top:18rpx; }.diagnosis-button { flex:1; margin:0; }.ai-explanation { margin-top:14rpx; line-height:1.65; color:#3b5b65; }.change-title { margin-top:28rpx; }.change { margin-bottom:15rpx; }
.task-status { display:inline-block; font-size:19rpx; padding:4rpx 12rpx; border-radius:999rpx; color:#68778d; background:#eef2f7; }.status-IN_PROGRESS { color:#1266c8; background:#eaf3ff; }.status-COMPLETED { color:#087d78; background:#e5fbf7; }.status-INSUFFICIENT_STOCK { color:#a56c00; background:#fff3d4; }.recommend-meta { display:flex; align-items:center; flex-wrap:wrap; gap:10rpx; margin-top:10rpx; }
.inventory-row { display:flex; flex-wrap:wrap; gap:10rpx; margin:0 6rpx 14rpx; }.inventory-tag { font-size:20rpx; color:#536887; background:#fff; border:1rpx solid #e1e9f5; border-radius:999rpx; padding:6rpx 14rpx; }
.notice-card { padding:34rpx 30rpx; }.notice-title { font-weight:700; margin-bottom:10rpx; }.stock-hint { margin-top:10rpx; color:#a56c00; font-size:23rpx; }.change-name { font-weight:650; }.change-line { margin-top:4rpx; line-height:1.5; }
.result-actions { margin-top:26rpx; }.result-progress { text-align:center; margin-bottom:14rpx; }.stock-notice { padding:18rpx 20rpx; border-radius:16rpx; background:#fff3d4; color:#8a5a00; font-size:24rpx; line-height:1.55; }
.done-card { padding:34rpx 30rpx; text-align:center; }.done-badge { width:84rpx; height:84rpx; margin:0 auto 14rpx; display:flex; align-items:center; justify-content:center; border-radius:50%; color:#fff; background:linear-gradient(135deg,#1677ff,#18b99e); font-size:44rpx; font-weight:800; }.done-title { font-size:36rpx; font-weight:750; margin-bottom:24rpx; }.done-stats { display:flex; gap:14rpx; margin-bottom:24rpx; }.done-stat { flex:1; padding:20rpx 8rpx; border-radius:18rpx; background:#f3f8ff; }.done-num { font-size:32rpx; font-weight:750; color:#1266c8; margin-bottom:6rpx; }.done-change-title { text-align:left; }.done-hint { margin-bottom:20rpx; }.done-primary { margin-bottom:16rpx; }
