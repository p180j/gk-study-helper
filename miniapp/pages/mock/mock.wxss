.paper,.stat,.compare{padding:26rpx}.paper .mini{margin:0;border:0;border-radius:999rpx;color:#fff;background:#1677ff}.notice,.block-title{margin:28rpx 0 14rpx;font-weight:750}.lines{line-height:1.8}.section-list{display:flex;justify-content:space-between;padding:20rpx 0;border-bottom:1rpx solid #edf2f9}.exam-top{display:flex;align-items:center;justify-content:space-between}.timer{color:#1677ff;font-size:40rpx;font-weight:800}.progress{font-weight:750}.danger{margin:0;color:#e34d61;background:#fff0f2;border:0}.numbers{white-space:nowrap;margin:18rpx 0}.number{display:inline-flex;width:60rpx;height:60rpx;margin-right:12rpx;align-items:center;justify-content:center;border-radius:18rpx;background:#fff;color:#72839c}.number.active{color:#fff;background:#1677ff}.question{padding:30rpx}.material{margin:20rpx 0;padding:22rpx;border-radius:18rpx;background:#f3f7fc;line-height:1.7}.stem{margin:24rpx 0;font-size:30rpx;line-height:1.65}.option{display:flex;gap:16rpx;margin:14rpx 0;padding:22rpx;border:2rpx solid #e2eaf5;border-radius:18rpx}.option.selected{border-color:#1677ff;background:#edf5ff}.key{font-weight:800}.essay-input{width:auto;min-height:420rpx;padding:22rpx;border-radius:18rpx;background:#f7f9fc}.actions{display:grid;grid-template-columns:.8fr .8fr 1.4fr;gap:10rpx;margin-top:26rpx}.actions button{width:100%;min-width:0;box-sizing:border-box;margin:0;padding:0 8rpx;font-size:21rpx}.score-card{text-align:center;background:linear-gradient(145deg,#fff,#edf8ff)}.score{margin:10rpx;color:#1677ff;font-size:80rpx;font-weight:850}.summary{display:flex;justify-content:center;gap:22rpx;color:#657894;font-size:22rpx}.stat .muted{margin-top:10rpx}.stat-primary{margin-top:14rpx;color:#1677ff;font-weight:750;font-size:28rpx}.stat-secondary{margin-top:8rpx;font-size:22rpx}.bars{margin:18rpx 0;color:#28517f;font-weight:700}.insight{padding:18rpx;border-radius:16rpx;background:#eafaf7;color:#24655d;line-height:1.6}.tip{margin:22rpx 8rpx;color:#7b8ba5;font-size:22rpx}
